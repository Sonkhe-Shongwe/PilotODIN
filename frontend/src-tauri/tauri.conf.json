{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pilotODIN",
  "version": "1.0.0-alpha.1",
  "identifier": "com.pilotodin.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pilotODIN",
        "width": 1380,
        "height": 860,
        "minWidth": 1010,
        "minHeight": 680,
        "backgroundColor": "#F7F9FD"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/pilotodin-engine",
      "binaries/pilotodin-inference"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "resources": {
      "resources/models/qwen3-1.7b-q4_k_m.gguf": "models/qwen3-1.7b-q4_k_m.gguf",
      "resources/models/model-manifest.json": "models/model-manifest.json",
      "resources/llama-runtime/": "llama-runtime/"
    }
  }
}
